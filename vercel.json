{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/platform",
      "destination": "/platform.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/waitlist",
      "destination": "/waitlist.html"
    }
  ]
}